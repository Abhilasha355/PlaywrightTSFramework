{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],               // <- removed @types/jest
    "resolveJsonModule": true,
    "outDir": "dist",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],        // <- add DOM if you use browser types
    "skipLibCheck": true,            // <- helps avoid noise from deps
    "sourceMap": true,
    "noEmit": true
  },
  "include": ["features/**/*.ts", "support/**/*.ts"],
  "ts-node": {
    "transpileOnly": true,
    "files": true
  }
}