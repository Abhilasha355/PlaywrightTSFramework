{
  "name": "playwrighttypescriptframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
 "scripts": {
  
  "pw:test": "playwright test",
  "pw:headed": "playwright test --headed",
  "pw:ui": "playwright test --ui",
  "pw:codegen": "playwright codegen",


  "pw:test:allure": "playwright test",
  "pw:allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
  "pw:allure:open": "allure open ./allure-report",
  "pw:report": "npm run pw:test:allure && npm run pw:allure:generate && npm run pw:allure:open",

  
  "cuke:test": "cucumber-js",
  "cuke:headed": "HEADLESS=false cucumber-js",
  "cuke:tags": "cucumber-js --tags '@smoke and not @wip'",
  "cuke:parallel": "cucumber-js --parallel 4",
  "cuke:report": "cucumber-js -f json:reports/cucumber.json"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@cucumber/pretty-formatter": "^3.2.0",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.14.10",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "expect": "^30.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "dotenv": "^16.6.1",
    "luxon": "^3.7.2"
  }
}
